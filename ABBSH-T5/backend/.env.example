# Copy this file to ".env" (same folder) and fill in your real values.
# Never commit the real ".env" file to GitHub — it's already in .gitignore.

# Your MongoDB connection string.
# From MongoDB Atlas: Database -> Connect -> Drivers -> copy the connection string,
# then replace <password> with your actual database user password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/abbsh_blogs?retryWrites=true&w=majority

# Any long random string — used to sign login tokens. Keep this secret.
JWT_SECRET=replace-with-a-long-random-string

# Which port the backend runs on (5000 unless you have a reason to change it)
PORT=5000
