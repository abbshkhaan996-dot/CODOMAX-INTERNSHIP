# Dependencies — these get reinstalled with "npm install", never upload them
node_modules/
backend/node_modules/

# Environment variables — contains your real MongoDB password and JWT secret.
# NEVER commit this file. Only .env.example (with placeholder values) is tracked.
backend/.env

# Old Module 2 runtime data (JSON files) — no longer used, but ignored just in case
backend/data/

# OS/editor junk
.DS_Store
Thumbs.db
*.log
